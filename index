  function boardPNG(sh, numbered, W){
    const padL = 30, padT = 30, padR = 8, padB = 8;
    const L = sh.stock.L, Wd = sh.stock.W, sc = (W - padL - padR) / L, H = Wd * sc;
    const TH = Math.ceil(H + padT + padB), R = 2;
    const cv = document.createElement('canvas');
    cv.width = W * R; cv.height = TH * R;
    const c = cv.getContext('2d');
    c.scale(R, R);
    c.fillStyle = '#FFFFFF'; c.fillRect(0, 0, W, TH);
    const INK = '#18221E', MUT = '#58675F';
    const X = v => padL + v * sc, Y = v => padT + v * sc;
    const mono = '11px "IBM Plex Mono",Consolas,monospace';
    const sans = '500 12px "IBM Plex Sans Arabic",Arial,sans-serif';
    const tw = s => s.length * 6.8 + 8;
    const T = (txt, x, y, font, color, align, rot) => {
      c.save(); c.font = font; c.fillStyle = color; c.textAlign = align || 'center'; c.textBaseline = 'alphabetic';
      c.translate(x, y); if (rot) c.rotate(-Math.PI / 2);
      c.fillText(txt, 0, rot ? 4 : 0); c.restore();
    };
    const line = (x1, y1, x2, y2, col, dash) => {
      c.beginPath(); c.setLineDash(dash || []); c.strokeStyle = col; c.lineWidth = 1; c.moveTo(x1, y1); c.lineTo(x2, y2); c.stroke(); c.setLineDash([]);
    };
    // dimension lines
    line(X(0), 19, X(L), 19, MUT); line(X(0), 14, X(0), 24, MUT); line(X(L), 14, X(L), 24, MUT);
    T(fmt(L), X(0) + L * sc / 2, 13, '12px "IBM Plex Mono",monospace', MUT);
    line(19, Y(0), 19, Y(Wd), MUT); line(14, Y(0), 24, Y(0), MUT); line(14, Y(Wd), 24, Y(Wd), MUT);
    T(fmt(Wd), 11, Y(0) + H / 2, '12px "IBM Plex Mono",monospace', MUT, 'center', true);
    // board + hatch
    c.fillStyle = '#FFFFFF'; c.fillRect(X(0), Y(0), L * sc, H);
    c.save(); c.beginPath(); c.rect(X(0), Y(0), L * sc, H); c.clip();
    for (let k = -H; k < L * sc; k += 7){ line(X(0) + k, Y(0) + H, X(0) + k + H, Y(0), '#C9D3CD'); }
    c.restore();
    c.strokeStyle = INK; c.lineWidth = 1.4; c.strokeRect(X(0), Y(0), L * sc, H);
    if (sh.trim > EPS){
      c.setLineDash([4, 3]); c.strokeStyle = MUT; c.lineWidth = 1;
      c.strokeRect(X(sh.trim), Y(sh.trim), (L - 2 * sh.trim) * sc, (Wd - 2 * sh.trim) * sc); c.setLineDash([]);
    }
    sh.free.forEach(f => {
      const w = f.w * sc, h = f.h * sc;
      if (w < 18 || h < 18) return;
      c.setLineDash([3, 3]); c.strokeStyle = MUT; c.lineWidth = 1; c.strokeRect(X(f.x), Y(f.y), w, h); c.setLineDash([]);
      const t = fmt(f.w) + '×' + fmt(f.h);
      if (w >= tw(t) && h >= 20) T(t, X(f.x) + w / 2, Y(f.y) + h / 2 + 4, mono, MUT);
    });
    numbered.forEach(p => {
      const x = X(p.x), y = Y(p.y), w = p.w * sc, h = p.h * sc;
      const ws = fmt(p.w), hs = fmt(p.h), both = ws + '×' + hs;
      c.fillStyle = '#' + partHex(p.it.pi); c.fillRect(x, y, w, h);
      c.strokeStyle = INK; c.lineWidth = 1; c.strokeRect(x, y, w, h);
      if (w >= Math.max(tw(ws), 34) && h >= Math.max(tw(hs), 34)){
        T(ws, x + w / 2, y + 13, mono, INK);
        T(hs, x + 10, y + h / 2, mono, INK, 'center', true);
        let nm = String(p.it.name);
        const maxCh = Math.floor((w - 44) / 6.6);
        if (h >= 46 && maxCh >= 3){
          if (nm.length > maxCh) nm = nm.slice(0, maxCh - 1) + '…';
          T(nm, x + w / 2, y + h / 2 + 4, sans, INK);
        }
        if (p.rotated && w >= 50 && h >= 40) T('↻', x + w - 6, y + h - 6, mono, MUT, 'end');
        if (sh.stock.gm !== 'n' && p.it.ga !== 'a' && w >= 50 && h >= 40) T(sh.stock.gm === 'v' ? '↕' : '↔', x + 6, y + h - 6, mono, MUT, 'start');
      } else if (w >= tw(both) && h >= 16){
        T(both, x + w / 2, y + h / 2 + 4, mono, INK);
      } else if (h >= tw(both) && w >= 16){
        T(both, x + w / 2, y + h / 2, mono, INK, 'center', true);
      } else if (w >= 14 && h >= 14){
        T(String(p.n), x + w / 2, y + h / 2 + 4, mono, INK);
      }
    });
    return { url: cv.toDataURL('image/png'), w: W, h: TH };
  }

  async function exportXlsx(){
    const d = last;
    if (!d || !d.res) throw new Error('لا توجد نتيجة للتصدير');
    if (typeof ExcelJS === 'undefined') throw new Error('مكتبة إكسل غير محمّلة');
    try { if (document.fonts && document.fonts.ready) await document.fonts.ready; } catch (e) {}
    const res = d.res, u = unitLabel();
    const trimV = Math.max(0, num(state.trim) || 0), kerfV = Math.max(0, num(state.kerf) || 0);
    res.sheets.forEach((sh, si) => {
      sh.trim = trimV;
      if (!sh.numbered) sh.numbered = sh.placed.slice().sort((a, b) => (a.y - b.y) || (a.x - b.x)).map((p, i) => Object.assign({ n: i + 1 }, p));
    });

    const wb = new ExcelJS.Workbook();
    wb.creator = 'محسّن قائمة القص'; wb.created = new Date();
    const FONT = 'Arial';
    const thin = { style: 'thin', color: { argb: 'FFC7D1CB' } };
    const border = { top: thin, left: thin, bottom: thin, right: thin };
    const solid = hex => ({ type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF' + hex } });
    const center = { horizontal: 'center', vertical: 'middle', wrapText: true };
    const start = { horizontal: 'right', vertical: 'middle', wrapText: true };

    const title = (ws, text, cols) => {
      ws.mergeCells(1, 1, 1, cols);
      const c = ws.getCell(1, 1);
      c.value = text; c.font = { name: FONT, bold: true, size: 15, color: { argb: 'FF18221E' } };
      c.fill = solid('E5AA00'); c.alignment = { horizontal: 'center', vertical: 'middle' };
      ws.getRow(1).height = 32;
    };
    const header = row => {
      row.eachCell(c => {
        c.font = { name: FONT, bold: true, color: { argb: 'FFFFFFFF' } };
        c.fill = solid('18221E'); c.alignment = center; c.border = border;
      });
      row.height = 24;
    };
    const cells = (row, alignFirst) => {
      row.eachCell((c, i) => {
        c.font = Object.assign({ name: FONT }, c.font || {});
        c.border = border;
        c.alignment = (i === 1 && alignFirst) ? start : center;
      });
      row.height = 20;
    };
    const setup = ws => {
      ws.views = [{ rightToLeft: true }];
      ws.pageSetup = { orientation: 'landscape', fitToPage: true, fitToWidth: 1, fitToHeight: 0, paperSize: 9 };
    };

    let sheetsArea = 0, usedArea = 0;
    res.sheets.forEach(sh => { sheetsArea += sh.stock.L * sh.stock.W; usedArea += sh.used; });
    const k2 = state.unit === 'mm' ? 1e6 : 1e4;
    const placedN = d.items.length - res.unplaced.length;

    /* 1) الملخص */
    const ws1 = wb.addWorksheet('الملخص');
    setup(ws1);
    ws1.columns = [{ width: 24 }, { width: 24 }, { width: 16 }, { width: 16 }, { width: 16 }, { width: 22 }, { width: 18 }];
    title(ws1, 'قائمة القص', 7);
    ws1.addRow([]);
    const kv = [
      ['التاريخ', new Date().toLocaleDateString('ar-EG')],
      ['وحدة القياس', u],
      ['سمك الشفرة', kerfV],
      ['تشذيب الحواف', trimV],
      ['عدد الألواح المستخدمة', res.sheets.length],
      ['نسبة الاستفادة', sheetsArea ? usedArea / sheetsArea : 0],
      ['الهالك (م²)', +((sheetsArea - usedArea) / k2).toFixed(2)],
      ['القطع الموزعة', placedN + ' من ' + d.items.length]
    ];
    kv.forEach(([k, v]) => {
      const r = ws1.addRow([k, v]);
      r.getCell(1).font = { name: FONT, bold: true }; r.getCell(1).fill = solid('ECF0ED');
      if (k === 'نسبة الاستفادة') r.getCell(2).numFmt = '0.0%';
      cells(r, true);
      r.getCell(2).alignment = center;
    });
    ws1.addRow([]);

    const secTitle = (ws, text) => {
      const r = ws.addRow([text]); r.getCell(1).font = { name: FONT, bold: true, size: 12 }; r.height = 22; return r;
    };
    secTitle(ws1, 'الألواح');
    header(ws1.addRow(['#', 'الخامة', 'الطول', 'العرض', 'عدد القطع', 'الاستفادة']));
    res.sheets.forEach((sh, i) => {
      const r = ws1.addRow([i + 1, sh.stock.name, sh.stock.L, sh.stock.W, sh.placed.length, sh.used / (sh.stock.L * sh.stock.W)]);
      r.getCell(6).numFmt = '0.0%';
      cells(r, false);
    });
    ws1.addRow([]);

    secTitle(ws1, 'القطع المطلوبة');
    header(ws1.addRow(['القطعة', 'الطول', 'العرض', 'المطلوب', 'الموزّع', 'اللوح', 'العروق']));
    const placedBy = {};
    res.sheets.forEach(sh => sh.placed.forEach(p => { placedBy[p.it.pi] = (placedBy[p.it.pi] || 0) + 1; }));
    state.parts.forEach((p, pi) => {
      const l = num(p.l), w = num(p.w), q = Math.round(num(p.q));
      if (!(l > 0 && w > 0 && q > 0)) return;
      const got = placedBy[pi] || 0;
      const stIdx = state.stock.findIndex(s => s.id === p.sid);
      const r = ws1.addRow([p.name || ('قطعة ' + (pi + 1)), l, w, q, got, stIdx > -1 ? (stIdx + 1) + '. ' + (state.stock[stIdx].name || 'لوح') : 'تلقائي', ({ l: 'مع الطول', w: 'مع العرض' })[p.gd] || 'لا تهم']);
      cells(r, true);
      r.getCell(1).fill = solid(partHex(pi));
      if (got < q) r.getCell(5).font = { name: FONT, bold: true, color: { argb: 'FFB3261E' } };
    });
    if (res.unplaced.length){
      ws1.addRow([]);
      const t = secTitle(ws1, 'قطع بلا مكان (لا توجد ألواح كافية أو القطعة أكبر من اللوح)');
      t.getCell(1).font = { name: FONT, bold: true, size: 12, color: { argb: 'FFB3261E' } };
      header(ws1.addRow(['القطعة', 'الطول', 'العرض']));
      res.unplaced.forEach(it => {
        const r = ws1.addRow([it.name, it.l, it.w]);
        cells(r, true);
        r.eachCell(c => { c.font = { name: FONT, color: { argb: 'FFB3261E' } }; });
      });
    }

    /* 2) قائمة القطع كاملة */
    const ws2 = wb.addWorksheet('قائمة القطع');
    setup(ws2);
    ws2.columns = [{ width: 10 }, { width: 8 }, { width: 26 }, { width: 14 }, { width: 14 }, { width: 14 }, { width: 14 }, { width: 12 }];
    ws2.addRow(['اللوح', '#', 'القطعة', 'أفقي', 'رأسي', 'من اليسار', 'من الأعلى', 'مدوّرة']);
    header(ws2.getRow(1));
    res.sheets.forEach((sh, si) => {
      sh.numbered.forEach(p => {
        const r = ws2.addRow([si + 1, p.n, p.it.name, p.w, p.h, p.x, p.y, p.rotated ? 'نعم' : '']);
        cells(r, false);
        r.getCell(3).alignment = start;
        r.getCell(3).fill = solid(partHex(p.it.pi));
      });
    });
    ws2.views = [{ rightToLeft: true, state: 'frozen', ySplit: 1 }];
    ws2.autoFilter = { from: { row: 1, column: 1 }, to: { row: 1, column: 8 } };

    /* 3) ورقة لكل لوح: الرسم ثم الجدول */
    res.sheets.forEach((sh, si) => {
      const ws = wb.addWorksheet('لوح ' + (si + 1));
      setup(ws);
      ws.columns = [{ width: 8 }, { width: 8 }, { width: 28 }, { width: 16 }, { width: 16 }, { width: 16 }, { width: 16 }];
      const pct = sh.used / (sh.stock.L * sh.stock.W);
      title(ws, 'لوح ' + (si + 1) + ' — ' + sh.stock.name + ' — الاستفادة ' + (pct * 100).toFixed(1) + '% — المقاس ' + fmt(sh.stock.L) + '×' + fmt(sh.stock.W) + ' ' + u + (sh.stock.gm !== 'n' && sh.placed.some(p => p.it.ga !== 'a') ? ' — العروق ' + (sh.stock.gm === 'v' ? '↕' : '↔') : ''), 7);
      const img = boardPNG(sh, sh.numbered, 900);
      const id = wb.addImage({ base64: img.url, extension: 'png' });
      ws.addImage(id, { tl: { col: 0.1, row: 2 }, ext: { width: img.w, height: img.h } });
      const rowsForImg = Math.ceil(img.h / 20) + 1;
      const hr = 3 + rowsForImg;
      for (let r = 2; r < hr; r++) ws.getRow(r).height = 15;
      ws.getRow(hr).values = ['#', '', 'القطعة', 'أفقي', 'رأسي', 'من اليسار', 'من الأعلى'];
      ws.mergeCells(hr, 1, hr, 2);
      ws.getCell(hr, 1).value = '#';
      header(ws.getRow(hr));
      sh.numbered.forEach(p => {
        const r = ws.addRow([p.n, '', p.it.name + (p.rotated ? '  ↻' : ''), p.w, p.h, p.x, p.y]);
        ws.mergeCells(r.number, 1, r.number, 2);
        cells(r, false);
        r.getCell(3).alignment = start;
        r.getCell(3).fill = solid(partHex(p.it.pi));
      });
      const nr = ws.addRow(['المقاسان بحسب الرسم: أفقي ثم رأسي. المسافات من الزاوية العليا اليسرى للوح بوحدة ' + u + '. ↻ تعني أن القطعة مدوّرة 90°.']);
      ws.mergeCells(nr.number, 1, nr.number, 7);
      nr.getCell(1).font = { name: FONT, size: 10, color: { argb: 'FF58675F' } };
      nr.getCell(1).alignment = { horizontal: 'right', wrapText: true };
      nr.height = 30;
    });

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    return blob;
  }


  /* ---------- Excel: prepared file with tap-to-save (iPhone friendly) ---------- */
  var xlsxBlob = null, xlsxUrl = '';
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  function clearXlsx(){
    if (xlsxUrl){ try { URL.revokeObjectURL(xlsxUrl); } catch (e) {} }
    xlsxBlob = null; xlsxUrl = '';
  }
  function canShareFile(){
    try {
      if (!xlsxBlob || !navigator.canShare || !navigator.share) return false;
      return navigator.canShare({ files: [new File([xlsxBlob], 'cutting-list.xlsx', { type: xlsxBlob.type })] });
    } catch (e) { return false; }
  }
  function xlsxBox(){
    if (!xlsxBlob) return '';
    const hasShare = !!navigator.share;
    return '<div class="xlbox"><span>ملف إكسل جاهز (' + Math.round(xlsxBlob.size / 1024) + ' ك.ب).</span>' +
      '<a class="btn primary" id="xlsxLink" href="' + xlsxUrl + '" download="cutting-list.xlsx">حفظ الملف</a>' +
      '<a class="btn" href="' + xlsxUrl + '" target="_blank" rel="noopener">فتح الملف</a>' +
      (hasShare ? '<button type="button" class="btn" data-act="share-xlsx">' + (canShareFile() ? 'مشاركة الملف' : 'مشاركة كنص') + '</button>' : '') +
      '<button type="button" class="btn" data-act="copytsv">نسخ لجدول إكسل</button>' +
      '<span class="note">' + (hasShare ? '' : 'هذا المتصفح لا يدعم المشاركة. ') +
      'إن لم يُحفظ الملف جرّب «نسخ لجدول إكسل» ثم الصقه في Excel أو Numbers.</span></div>';
  }
  function tsvText(){
    if (!last || !last.res) return '';
    const rows = [['اللوح', '#', 'القطعة', 'أفقي', 'رأسي', 'من اليسار', 'من الأعلى', 'مدوّرة'].join('\t')];
    last.res.sheets.forEach((sh, si) => {
      (sh.numbered || []).forEach(p => {
        rows.push([si + 1, p.n, String(p.it.name).replace(/[\t\r\n]+/g, ' '), fmt(p.w), fmt(p.h), fmt(p.x), fmt(p.y), p.rotated ? 'نعم' : ''].join('\t'));
      });
    });
    return rows.join('\n');
  }
  async function copyOut(text, okMsg){
    const st = $('#copyStatus'), box = $('#copybox');
    try {
      await navigator.clipboard.writeText(text);
    } catch (err) {
      let ok = false;
      try {
        const ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;opacity:0;font-size:16px';
        document.body.appendChild(ta); ta.focus(); ta.select(); ta.setSelectionRange(0, text.length);
        ok = document.execCommand('copy'); ta.remove();
      } catch (e2) {}
      if (!ok){
        if (st) st.textContent = 'انسخ النص من الصندوق';
        if (box) box.innerHTML = '<textarea class="copybox" readonly id="copyTa">' + esc(text) + '</textarea>';
        const t = $('#copyTa'); if (t){ t.focus(); t.select(); }
        return;
      }
    }
    if (box) box.innerHTML = '';
    if (st) st.textContent = okMsg;
  }
  document.addEventListener('click', e => {
    const c = e.target.closest('[data-act="copytsv"]');
    if (c){ copyOut(tsvText(), 'تم النسخ. الصقه في خلية فارغة في Excel أو Numbers'); return; }
    const b = e.target.closest('[data-act="share-xlsx"]');
    if (!b || !xlsxBlob || !navigator.share) return;
    let p;
    try {
      const f = new File([xlsxBlob], 'cutting-list.xlsx', { type: xlsxBlob.type });
      p = (navigator.canShare && navigator.canShare({ files: [f] }))
        ? navigator.share({ files: [f], title: 'قائمة القص' })
        : navigator.share({ title: 'قائمة القص', text: summaryText(last) });
    } catch (err) { p = Promise.reject(err); }
    p.catch(err => {
      if (err && err.name === 'AbortError') return;
      const s = $('#copyStatus'); if (s) s.textContent = 'تعذّرت المشاركة: ' + (err && err.message || err);
    });
  });
  renderInputs();
  renderSettings();
  run();
})();
</script>
</body></html>
