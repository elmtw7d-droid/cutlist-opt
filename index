/* Layout: a workbench. Inputs column on the start side, sheet drawings beside it. The tape-measure strip is the one bold motif. */
:root{
  --bg:#ECF0ED; --surface:#F7F9F8; --field:#FFFFFF; --ink:#18221E; --muted:#58675F; --line:#C7D1CB;
  --accent:#E5AA00; --accent-ink:#18221E; --board:#FFFFFF; --hatch:#B9C5BE;
  --warn-bg:#FBE9E4; --warn-ink:#8A2A12; --hl:#FFF0B8;
  --p0:hsl(32 62% 78%); --p1:hsl(165 38% 75%); --p2:hsl(205 55% 79%); --p3:hsl(345 55% 82%); --p4:hsl(52 70% 76%);
  --p5:hsl(262 40% 82%); --p6:hsl(95 40% 75%); --p7:hsl(12 62% 79%); --p8:hsl(185 45% 74%); --p9:hsl(300 30% 80%);
  --f-display:'Readex Pro','IBM Plex Sans Arabic',system-ui,sans-serif;
  --f-body:'IBM Plex Sans Arabic',system-ui,sans-serif;
  --f-mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#101714; --surface:#18211D; --field:#111815; --ink:#E6EEE9; --muted:#8FA198; --line:#2F3C36;
    --accent:#F2BC1B; --accent-ink:#141A17; --board:#202B26; --hatch:#33423B;
    --warn-bg:#3A1F18; --warn-ink:#F2B8A6; --hl:#4A3E10;
    --p0:hsl(32 34% 30%); --p1:hsl(165 28% 27%); --p2:hsl(205 34% 30%); --p3:hsl(345 32% 31%); --p4:hsl(52 36% 29%);
    --p5:hsl(262 26% 33%); --p6:hsl(95 26% 27%); --p7:hsl(12 36% 30%); --p8:hsl(185 30% 27%); --p9:hsl(300 20% 31%);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#101714; --surface:#18211D; --field:#111815; --ink:#E6EEE9; --muted:#8FA198; --line:#2F3C36;
  --accent:#F2BC1B; --accent-ink:#141A17; --board:#202B26; --hatch:#33423B;
  --warn-bg:#3A1F18; --warn-ink:#F2B8A6; --hl:#4A3E10;
  --p0:hsl(32 34% 30%); --p1:hsl(165 28% 27%); --p2:hsl(205 34% 30%); --p3:hsl(345 32% 31%); --p4:hsl(52 36% 29%);
  --p5:hsl(262 26% 33%); --p6:hsl(95 26% 27%); --p7:hsl(12 36% 30%); --p8:hsl(185 30% 27%); --p9:hsl(300 20% 31%);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--ink); font-family:var(--f-body); font-size:15px; line-height:1.6;
  padding-block:16px 48px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
.app{max-width:1320px;margin-inline:auto}
.tape{
  height:18px; background-color:var(--accent); border-radius:2px;
  background-image:
    repeating-linear-gradient(90deg,var(--accent-ink) 0 1.5px,transparent 1.5px 40px),
    repeating-linear-gradient(90deg,var(--accent-ink) 0 1px,transparent 1px 8px);
  background-size:100% 100%,100% 45%; background-repeat:no-repeat; background-position:0 0;
}
header.top{display:flex;flex-direction:column;gap:6px;margin-bottom:18px}
h1{font-family:var(--f-display);font-weight:600;font-size:clamp(24px,4vw,32px);line-height:1.25;margin:14px 0 0;text-wrap:balance}
.sub{margin:0;color:var(--muted);max-width:62ch}
.grid{display:grid;grid-template-columns:minmax(0,430px) minmax(0,1fr);gap:20px;align-items:start}
@media (max-width:980px){.grid{grid-template-columns:minmax(0,1fr)}}
.inputs{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:4px 14px 14px}
.sec{padding-block:14px;border-bottom:1px solid var(--line)}
.sec:last-child{border-bottom:0;padding-bottom:0}
h2{font-family:var(--f-display);font-weight:500;font-size:16px;margin:0 0 10px;display:flex;align-items:center;justify-content:space-between;gap:8px}
h2 small{font-family:var(--f-body);font-weight:400;font-size:12px;color:var(--muted)}
.hdr,.row{display:grid;gap:6px;align-items:center}
.stock .hdr,.stock .row{grid-template-columns:minmax(0,1.25fr) repeat(3,minmax(0,.72fr)) 30px}
.parts .hdr,.parts .row{grid-template-columns:minmax(0,1.25fr) repeat(3,minmax(0,.72fr)) 30px}
.subline{grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:6px}
.subline .bsel{grid-column:auto}
.bsel{grid-column:1/-1;display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--muted);margin-top:-2px}
.bsel select{flex:1;min-width:0;padding:5px 6px;font-size:13px}
.tog{margin-top:10px}
.swb{display:flex;align-items:center;gap:10px;font:inherit;font-size:14px;background:none;border:0;padding:4px 0;color:var(--ink);cursor:pointer;text-align:start}
.swb i{position:relative;flex:none;width:38px;height:22px;border-radius:11px;background:var(--line);transition:background .15s}
.swb i::after{content:"";position:absolute;top:3px;inset-inline-start:3px;width:16px;height:16px;border-radius:50%;background:var(--field);border:1px solid var(--muted);transition:inset-inline-start .15s}
.swb[aria-pressed="true"] i{background:var(--accent)}
.swb[aria-pressed="true"] i::after{inset-inline-start:19px;border-color:var(--accent-ink)}
.swb:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.grainon .rot{opacity:.35;pointer-events:none}
@media (prefers-reduced-motion:reduce){.swb i,.swb i::after{transition:none}}
.jump{position:fixed;inset-inline:0;bottom:0;z-index:20;display:flex;justify-content:center;
  padding:10px max(16px,env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-right,0px));
  background:linear-gradient(to top,var(--bg) 60%,transparent);pointer-events:none}
.jump .btn{pointer-events:auto;box-shadow:0 2px 10px rgba(0,0,0,.25);padding:10px 18px;font-size:15px}
[hidden]{display:none!important}
@media (max-width:700px){.in,.in.num,.bsel select,.field select{font-size:16px!important}}
.xlbox{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--surface);border:1px solid var(--accent);border-radius:6px;padding:10px 14px}
.xlbox span{flex:1 1 100%;font-size:14px}
a.btn{text-decoration:none;display:inline-block}
.hdr{font-size:12px;color:var(--muted);text-align:center;margin-bottom:4px}
.hdr span:first-child{text-align:start}
.row{margin-bottom:6px}
.in{
  width:100%;min-width:0;padding:7px 6px;border:1px solid var(--line);background:var(--field);color:var(--ink);
  border-radius:4px;font-family:var(--f-body);font-size:14px;
}
.in.num{font-family:var(--f-mono);font-size:13px;text-align:center;padding-inline:2px}
.in.nm{border-inline-start:5px solid var(--sw,var(--line))}
.in.bad{border-color:var(--warn-ink);background:var(--warn-bg)}
.in::placeholder{color:var(--muted);opacity:.8}
:is(.in,.btn,.x,.rot,.seg button):focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.x,.rot{
  height:32px;border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:4px;cursor:pointer;
  font-size:16px;line-height:1;padding:0;font-family:var(--f-body);
}
.x:hover{color:var(--warn-ink);border-color:var(--warn-ink)}
.rot[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn{
  font:inherit;font-size:14px;padding:7px 12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);
  border-radius:4px;cursor:pointer;
}
.btn:hover{border-color:var(--ink)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:600}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.hint{font-size:12.5px;color:var(--muted);margin:8px 0 0}
.settings{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
@media (max-width:420px){.settings{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.settings .unit{grid-column:1/-1}}
.field label,.field .lb{display:block;font-size:12.5px;color:var(--muted);margin-bottom:4px}
.seg{display:flex;border:1px solid var(--line);border-radius:4px;overflow:hidden}
.seg button{flex:1;font:inherit;font-size:14px;padding:7px 4px;background:var(--field);color:var(--ink);border:0;cursor:pointer}
.seg button+button{border-inline-start:1px solid var(--line)}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg);font-weight:600}

/* results */
main{min-width:0;display:flex;flex-direction:column;gap:16px}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
@media (min-width:560px){.stats{grid-template-columns:repeat(4,minmax(0,1fr))}}
.stats>div{background:var(--surface);padding:10px 14px;display:flex;flex-direction:column;gap:2px}
.stats .k{font-size:12.5px;color:var(--muted)}
.stats b{font-family:var(--f-mono);font-weight:500;font-size:22px;font-variant-numeric:tabular-nums}
.stats b small{font-family:var(--f-body);font-size:12px;color:var(--muted);font-weight:400}
.resbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.status{font-size:13px;color:var(--muted)}
.warn{background:var(--warn-bg);color:var(--warn-ink);border:1px solid var(--warn-ink);border-radius:6px;padding:10px 14px}
.warn b{display:block;margin-bottom:2px}
.warn ul{margin:4px 0 0;padding-inline-start:20px}
.empty{background:var(--surface);border:1px dashed var(--line);border-radius:6px;padding:28px 18px;text-align:center;color:var(--muted)}
.copybox{width:100%;min-height:120px;font-family:var(--f-mono);font-size:12.5px;background:var(--field);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:8px;direction:rtl}
.sheet{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:12px;min-width:0}
.sheet>header{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;margin-bottom:10px}
.sheet h3{font-family:var(--f-display);font-weight:500;font-size:17px;margin:0}
.meta{font-family:var(--f-mono);font-size:13px;color:var(--muted);direction:ltr;unicode-bidi:isolate}
.util{margin-inline-start:auto;display:flex;align-items:center;gap:8px;font-family:var(--f-mono);font-size:13px}
.meter{display:inline-block;width:90px;height:8px;background:var(--line);border-radius:4px;overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent)}
.draw{overflow-x:auto;padding-bottom:4px}
.sheetsvg{display:block;direction:ltr}
.sheetsvg text{fill:var(--ink)}
.sheetsvg .board{fill:var(--board);stroke:var(--ink);stroke-width:1.2}
.sheetsvg .hatch{stroke:var(--hatch);stroke-width:1}
.sheetsvg .trim{fill:none;stroke:var(--muted);stroke-dasharray:4 3}
.sheetsvg .free{fill:none;stroke:var(--muted);stroke-dasharray:3 3}
.sheetsvg .dimline{stroke:var(--muted);stroke-width:1}
.sheetsvg .pc{stroke:var(--ink);stroke-width:1}
.sheetsvg .piece.hl .pc{stroke-width:3}
.sheetsvg .t-mono{font:11px var(--f-mono)}
.sheetsvg .t-dim{font:11px var(--f-mono);fill:var(--muted)}
.sheetsvg .t-name{font:500 12px var(--f-body)}
.sheetsvg .t-sheet{font:12px var(--f-mono);fill:var(--muted)}
.c0{fill:var(--p0)}.c1{fill:var(--p1)}.c2{fill:var(--p2)}.c3{fill:var(--p3)}.c4{fill:var(--p4)}
.c5{fill:var(--p5)}.c6{fill:var(--p6)}.c7{fill:var(--p7)}.c8{fill:var(--p8)}.c9{fill:var(--p9)}
details{margin-top:8px}
summary{cursor:pointer;font-size:14px;padding-block:4px}
.tbl{overflow-x:auto;margin-top:6px}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{padding:5px 10px;text-align:start;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-weight:500;color:var(--muted);font-size:12.5px}
td.n{font-family:var(--f-mono);font-variant-numeric:tabular-nums;direction:ltr;text-align:end}
tr.hl td{background:var(--hl)}
.sw{display:inline-block;width:10px;height:10px;border:1px solid var(--ink);margin-inline-end:6px;vertical-align:-1px}
.note{font-size:12.5px;color:var(--muted);margin:6px 0 0}
@media print{
  :root{color-scheme:light}
  body{padding:0;background:#fff}
  .tape,.inputs,.resbar,#copybox{display:none!important}
  .grid{display:block}
  .sheet{break-inside:avoid;page-break-inside:avoid;margin-bottom:12px}
  .draw{overflow:visible}
  .sheetsvg{max-width:100%;height:auto}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>

<div id="jump" class="jump" hidden>
  <button type="button" id="jumpBtn" class="btn primary"><span id="jumpTxt"></span> · عرض الرسم ↓</button>
</div>
<div class="app" dir="rtl" lang="ar">
  <div id="nojs" class="warn" role="alert" style="margin-bottom:14px">
    <b>الصفحة لا تعمل في هذا العرض</b>
    هذا العرض (معاينة الملفات أو واتساب أو البريد) يمنع تشغيل البرنامج. افتح الملف في متصفح مثل Safari أو Chrome، أو استخدم رابط الصفحة المنشورة. على الآيفون: من «الملفات» اضغط مطولًا على الملف ثم «مشاركة» ثم اختر متصفحًا أو تطبيقًا يفتح صفحات الويب.
  </div>
  <div id="errbar" class="warn" role="alert" hidden style="margin-bottom:14px"></div>
  <header class="top">
    <div class="tape" aria-hidden="true"></div>
    <h1>محسّن قائمة القص</h1>
    <p class="sub">أدخل الألواح التي معك والمقاسات المطلوبة. يوزّع البرنامج القطع على الألواح ويرسم مكان كل قطعة ومقاسها وسمك الشفرة بينها.</p>
  </header>

  <div class="grid">
    <aside class="inputs" id="inputs">
      <section class="sec stock">
        <h2>الألواح المتوفرة <small>الأصغر أو الباقي أولًا</small></h2>
        <div class="hdr"><span>الخامة</span><span>الطول</span><span>العرض</span><span>العدد</span><span></span></div>
        <div id="stockList"></div>
        <div class="actions"><button class="btn" data-act="add-stock">+ لوح</button></div>
      </section>

      <section class="sec parts">
        <h2>القطع المطلوبة <small>الطول بمحاذاة طول اللوح</small></h2>
        <div class="hdr"><span>القطعة</span><span>الطول</span><span>العرض</span><span>العدد</span><span></span></div>
        <div id="partList"></div>
        <div class="actions">
          <button class="btn" data-act="add-part">+ قطعة</button>
          <button class="btn" data-act="clear-parts">مسح القطع</button>
        </div>
        <div class="field" style="margin-top:10px"><label for="bulkGrain">تطبيق اتجاه العروق على كل القطع</label>
          <select id="bulkGrain" class="in"><option value="">اختر…</option><option value="l">العروق مع الطول</option><option value="w">العروق مع العرض</option><option value="a">لا تهم (أي اتجاه)</option></select></div>
        <p class="hint">القطع المكتوبة الآن مثال لخزانة مطبخ، عدّلها أو امسحها. «العروق مع الطول» تعني أن اتجاه عروق القطعة بمحاذاة الرقم الأول (الطول)، و«لا تهم» تسمح بتدويرها كما يناسب. اتجاه عروق اللوح يُحدَّد في قائمة الألواح. عند إضافة أكثر من لوح يظهر تحت كل قطعة اختيار اللوح الذي تُقص منه، فتفصل خامة عن أخرى ويظهر رسم كل لوح على حدة.</p>
      </section>

      <section class="sec">
        <h2>الإعدادات</h2>
        <div class="settings" data-t="set">
          <div class="field unit"><span class="lb">وحدة القياس</span>
            <div class="seg" role="group" aria-label="وحدة القياس">
              <button type="button" data-act="unit" data-v="mm" aria-pressed="true">مم</button>
              <button type="button" data-act="unit" data-v="cm" aria-pressed="false">سم</button>
            </div>
          </div>
          <div class="field"><label for="kerf">سمك الشفرة</label>
