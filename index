         '<line class="dimline" x1="14" y1="' + Y(0) + '" x2="24" y2="' + Y(0) + '"/><line class="dimline" x1="14" y1="' + Y(Wd) + '" x2="24" y2="' + Y(Wd) + '"/>' +
