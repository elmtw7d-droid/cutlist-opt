        s += '<text class="t-mono" transform="translate(' + (x + 10) + ',' + (y + h / 2) + ') rotate(-90)" text-anchor="middle" dy="0.35em">' + hs + '</text>';
        let nm = String(p.it.name);
        const maxCh = Math.floor((w - 44) / 6.6);
